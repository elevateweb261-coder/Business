# Copiază acest fișier ca `.env` și completează valorile. Nu pune `.env` în arhive sau în git.

# development | production
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Adresa publică a aplicației (folosită în linkurile din emailuri). Obligatorie în producție.
APP_URL=http://localhost:3000

# Calea bazei de date SQLite (relativă la proiect).
DATABASE_PATH=data/metamorf.db

# Sesiuni
SESSION_DAYS=30
# true dacă aplicația e servită prin HTTPS (implicit: dedus din APP_URL)
# COOKIE_SECURE=true
# true doar dacă rulezi în spatele unui proxy de încredere (pentru IP-ul real al clientului)
TRUST_PROXY=false
# Costul scrypt pentru parole (2^N). 17 = recomandarea OWASP.
SCRYPT_COST=17

# Email. Momentan doar „outbox”: mesajele se scriu în data/outbox și în consolă (doar pentru dezvoltare).
MAIL_MODE=outbox
MAIL_FROM=Metamorf <no-reply@localhost>

# --- Etapele următoare (încă neutilizate) ---
# Cheia furnizorului AI — se păstrează DOAR pe server.
# ANTHROPIC_API_KEY=
# Plăți (mod test)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
